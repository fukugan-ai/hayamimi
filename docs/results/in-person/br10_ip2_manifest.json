  },
  {
    "end_sample": 3020511,
    "lang": "en",
    "ref": "HIS FIRST IMPULSE WAS TO WRITE BUT FOUR WORDS IN REPLY GO TO THE DEVIL",
    "sha256": "1055462f3777bd83e23bc6bd7d67d6e3f624ccc5d70d3a368effe4802cdb34e0",

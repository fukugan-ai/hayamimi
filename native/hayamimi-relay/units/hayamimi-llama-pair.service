# A trial llama-server for hayamimi-relay: the translation model CAT-Translate-3.3b
# at Q6_K on 127.0.0.1:18083. It exists to measure the latency of the
# translation stage with a lighter quantization than the default server. It is
# reached only when `--llm` names it:
#
#   hayamimi-relay live --llm http://127.0.0.1:18083
#
# The default `--llm` (http://127.0.0.1:8080) and the second server on 18081
# (hayamimi-llama-other.service) are not touched by this unit.
#
# Memory: the weights and the four slots take about 2.6 GiB of GPU memory.
# Start it only when the GPU has room under the 14000 MiB budget of `hayamimi
# --gpu-budget` (query: `nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits`).
# Stop hayamimi-llama-other.service first when it does not fit; that server is
# idle unless a language outside the live pair is translated.
#
# `-c 8192 -np 4` gives each of the four slots a context of 2048 tokens.
#
# Install: mkdir -p ~/.config/systemd/user
#          cp native/hayamimi-relay/units/hayamimi-llama-pair.service ~/.config/systemd/user/
#          systemctl --user daemon-reload
# Start  : systemctl --user start hayamimi-llama-pair.service
# Check  : curl -s http://127.0.0.1:18083/health      (loading: 503, ready: {"status":"ok"})
# Stop   : systemctl --user stop hayamimi-llama-pair.service
# Remove : systemctl --user stop hayamimi-llama-pair.service
#          rm ~/.config/systemd/user/hayamimi-llama-pair.service
#          systemctl --user daemon-reload
# Restore the second server after a trial that stopped it:
#          systemctl --user start hayamimi-llama-other.service
[Unit]
Description=llama-server for hayamimi-relay, translation trial (CAT-Translate-3.3b Q6_K, 127.0.0.1:18083)
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
Slice=engines.slice
ExecStart=%h/source/llama.cpp/build-cuda120/bin/llama-server -m /mnt/h3-models/ollama/CAT-Translate-3.3b-Q6_K.gguf --host 127.0.0.1 --port 18083 -ngl 99 -c 8192 -np 4
Restart=no
MemoryMax=8G
MemorySwapMax=0
# SIGKILL, as the sibling llama-server units: this build ignores SIGTERM while
# it prints "cleaning up before exit...".
KillSignal=SIGKILL
SuccessExitStatus=SIGKILL
TimeoutStopSec=10
